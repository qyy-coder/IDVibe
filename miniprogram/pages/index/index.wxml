<!--
  AI一照成证 — 首页
  功能: 选择照片 → 选择规格 → 选择背景 → 生成证件照
-->
<view class="container">
  <!-- 顶部标题区 -->
  <view class="header">
    <view class="header-title">AI一照成证</view>
    <view class="header-subtitle">智能证件照生成与优化系统</view>
  </view>

  <!-- 照片选择区 -->
  <view class="card">
    <view class="card-title">📷 选择照片</view>

    <view class="photo-zone" bindtap="choosePhoto" wx:if="{{!selectedPhoto}}">
      <view class="photo-placeholder">
        <view class="placeholder-icon">+</view>
        <view class="placeholder-text">点击选择或拍摄照片</view>
        <view class="placeholder-hint">支持 JPG/PNG，请确保面部清晰、光线均匀</view>
      </view>
    </view>

    <view class="photo-zone selected" wx:else>
      <image class="selected-photo" src="{{selectedPhoto}}" mode="aspectFit" />
      <view class="photo-actions">
        <button class="btn btn-outline small-btn" bindtap="choosePhoto">重新选择</button>
      </view>
    </view>
  </view>

  <!-- 规格选择区 -->
  <view class="card">
    <view class="card-title">📐 证件照规格</view>
    <view class="option-tags">
      <view
        wx:for="{{specs}}"
        wx:key="name"
        class="option-tag {{currentSpec === item.name ? 'active' : ''}}"
        data-spec="{{item.name}}"
        bindtap="selectSpec"
      >
        {{item.label}}
      </view>
    </view>
    <view class="spec-hint" wx:if="{{currentSpecInfo}}">
      {{currentSpecInfo.usage}} | {{currentSpecInfo.mm_width}}×{{currentSpecInfo.mm_height}}mm
    </view>
  </view>

  <!-- 背景色选择区 -->
  <view class="card">
    <view class="card-title">🎨 背景颜色</view>
    <view class="color-row">
      <view
        wx:for="{{colors}}"
        wx:key="name"
        class="color-item {{currentColor === item.name ? 'active' : ''}}"
        data-color="{{item.name}}"
        bindtap="selectColor"
      >
        <view class="color-dot" style="background-color: {{item.hex}};"></view>
        <view class="color-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 排版选择区 -->
  <view class="card">
    <view class="card-title">🖼️ 排版方案 <text class="optional-tag">选填</text></view>
    <view class="option-tags">
      <view
        class="option-tag {{currentLayout === '' ? 'active' : ''}}"
        data-layout=""
        bindtap="selectLayout"
      >
        仅生成单张
      </view>
      <view
        wx:for="{{layouts}}"
        wx:key="name"
        class="option-tag {{currentLayout === item.name ? 'active' : ''}}"
        data-layout="{{item.name}}"
        bindtap="selectLayout"
      >
        {{item.name}}
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <view class="action-area safe-bottom">
    <button
      class="btn btn-primary generate-btn"
      bindtap="generatePhoto"
      disabled="{{!selectedPhoto || generating}}"
    >
      {{generating ? '生成中...' : '生成证件照 ✨'}}
    </button>
  </view>

  <!-- 加载遮罩 -->
  <view class="loading-overlay" wx:if="{{generating}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">{{loadingText}}</view>
  </view>

  <!-- 提示信息 -->
  <view class="tips">
    <view class="tips-title">💡 拍摄建议</view>
    <view class="tips-item">• 正对镜头，双眼平视</view>
    <view class="tips-item">• 双肩可见，背景简洁</view>
    <view class="tips-item">• 光线均匀，避免阴阳脸</view>
    <view class="tips-item">• 保持中性表情，不露齿</view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    AI一照成证 v0.1.0 | 团队: 肖清越 / 高泽宇 / 龚剑
  </view>
</view>
