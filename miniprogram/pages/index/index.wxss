/* 首页样式 */

.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 4rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* 照片选择区 */
.photo-zone {
  border: 4rpx dashed var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: all 0.2s;
}

.photo-zone.selected {
  border-color: var(--primary);
  border-style: solid;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: #fafafa;
}

.placeholder-icon {
  font-size: 72rpx;
  color: var(--text-hint);
  font-weight: 200;
  line-height: 1;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.placeholder-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
}

.selected-photo {
  width: 100%;
  max-height: 500rpx;
}

.photo-actions {
  display: flex;
  justify-content: center;
  padding: 20rpx;
}

.small-btn {
  height: 56rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

/* 规格提示 */
.spec-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

/* 颜色选择 */
.color-row {
  display: flex;
  gap: 40rpx;
  align-items: center;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.color-item.active .color-dot {
  border-color: var(--primary);
  transform: scale(1.15);
  box-shadow: 0 0 0 4rpx rgba(26, 115, 232, 0.2);
}

.color-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.color-item.active .color-label {
  color: var(--primary);
  font-weight: 500;
}

.optional-tag {
  font-size: 22rpx;
  color: var(--text-hint);
  font-weight: normal;
}

/* 生成按钮 */
.action-area {
  padding: 20rpx 0 40rpx;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  border-radius: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 115, 232, 0.3);
}

/* 加载动画 */
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 拍摄建议 */
.tips {
  background: #fff3cd;
  border-radius: var(--radius);
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #856404;
  margin-bottom: 12rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.8;
  opacity: 0.8;
}

/* 版本信息 */
.version-info {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
  padding: 30rpx 0 20rpx;
}
